{
  "name": "pr-sweep-desktop",
  "version": "0.7.0",
  "private": true,
  "author": "hazeliscoding",
  "description": "PR Sweep — a desktop PR dashboard for teams working across a GitHub organization.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "start": "electron .",
    "package": "electron-builder",
    "package:win": "electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.62.1",
    "typescript": "~5.5.0"
  },
  "build": {
    "appId": "dev.prsweep.app",
    "productName": "PR Sweep",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "hazeliscoding",
      "repo": "pr-sweep"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/tray-alert.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "pr-sweep-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "pr-sweep-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
